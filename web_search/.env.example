# Brave Search API Key (required)
# Get your key from: https://brave.com/search/api/
BRAVE_API_KEY=your_api_key_here

# Optional: Tool Configuration (set at initialization, like native tool)
# These match the parameters in Claude's native web_search_20250305 tool

# Maximum number of searches per session
WEB_SEARCH_MAX_USES=5

# Only include results from these domains (comma-separated)
# WEB_SEARCH_ALLOWED_DOMAINS=example.com,trusteddomain.org

# Never include results from these domains (comma-separated)
# WEB_SEARCH_BLOCKED_DOMAINS=untrustedsource.com,spam.com

# Maximum number of results to return per search
WEB_SEARCH_MAX_RESULTS=5

# User location for localized search results
# WEB_SEARCH_LOCATION_CITY=San Francisco
# WEB_SEARCH_LOCATION_REGION=California
# WEB_SEARCH_LOCATION_COUNTRY=US
# WEB_SEARCH_LOCATION_TIMEZONE=America/Los_Angeles
